{
    "name": "root/public",
    "require": {
        "doctrine/orm": "^3.6",
        "doctrine/dbal": "^4.4",
        "doctrine/migrations": "^3.9",
        "symfony/cache": "^7.0",
        "symfony/console": "^7.0",
        "symfony/var-exporter": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "schema:validate": "php bin/doctrine orm:validate-schema",
        "schema:diff": "php bin/doctrine orm:schema-tool:update --dump-sql"
    },
    "authors": [
        {
            "name": "Bruno Rovela"
        }
    ],
    "require-dev": {
        "symfony/var-dumper": "^7.0"
    }
}